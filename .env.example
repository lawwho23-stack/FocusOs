# Copy this file to .env and fill in your Supabase values.
# In Supabase Dashboard: Project Settings -> Database -> Connection string.
# Use "Transaction pooler" (port 6543) for DATABASE_URL.
# Use "Direct connection" (port 5432) for DIRECT_URL.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# AI Coach (OpenRouter). One key pays for both the Jev judgments
# (TypeSafe System One via OpenRouter) and the chat model that writes the message.
# Get a key at https://openrouter.ai/settings/keys — add it in Vercel too.
OPENROUTER_API_KEY=""
# Optional: any OpenRouter chat model id. Default: deepseek/deepseek-v4-flash-0731
# COACH_MODEL="deepseek/deepseek-v4-flash-0731"
